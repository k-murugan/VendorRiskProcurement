     <f:Card class="sapUiLargeMargin"
            width="350px"
            height="250px"
        >
            <f:header>
                <card:Header
                iconSrc="sap-icon://employee" 
                title="Total Vendors" />
            </f:header>
            <f:content>
                <VBox justifyContent="Center"
                       alignItems="Center">
                    <ObjectNumber
                        class="sapUiLargeMargin"
                        id="vendorCount"
                        number="0"
                        unit="Vendors"
                    />
                </VBox>
            </f:content>
        </f:Card>
        <f:Card class="sapUiLargeMargin"
            width="350px"
            height="250px"
        >
            <f:header>
                <card:Header
                iconSrc="sap-icon://employee" 
                title="Active Vendors" />
            </f:header>
            <f:content>
                <VBox justifyContent="Center"
                       alignItems="Center">
                    <!-- <ObjectNumber
                        class="sapUiLargeMargin"
                        id="vendorActive"
                        unit="Vendors"
                    /> -->
                    <layoutData>
                    <layout:GridData span="XL12 L12 M12 S12"/>
                    </layoutData>
                    	<FlexBox width="20rem" 
                                 height="10rem" 
                                 >
		<items>
			<m:InteractiveDonutChart selectionChanged=".onSelectionChanged">
				<m:segments>
					<!-- <m:InteractiveDonutChartSegment label="Implementation Phase" value="40.0" displayedValue="40.0%" color="Error"/> -->
					<m:InteractiveDonutChartSegment label="Active" value="3" displayedValue="40%" color="Critical"/>
					<m:InteractiveDonutChartSegment label="Total " value="5" displayedValue="60%" color="Good"/>
				</m:segments>
			</m:InteractiveDonutChart>
		</items>
	</FlexBox>
                </VBox>
            </f:content>
        </f:Card>
        <ToolbarSpacer />
        <Button
            class="sapUiSmallMargin"
            text="+ Add Vendor"
            type="Emphasized"
            press=".addVendor"
        />
        <Table
            id="vendorTable"
            items="{
                    path: '/Vendors',
                    sorter: {
                        path: 'vendorName'
                    }
                }"
        >
            <!-- <headerToolbar>
                <OverflowToolbar>
                    <Title text="Vendor List" />
                </OverflowToolbar>
            </headerToolbar> -->

            <columns>
                <Column>
                    <Text text="Vendor Code" />
                </Column>

                <Column>
                    <Text text="Vendor Name" />
                </Column>

                <Column>
                    <Text text="Vendor Category" />
                </Column>

                <Column>
                    <Text text="Material Category" />
                </Column>

                <Column>
                    <Text text="Risk Level" />
                </Column>
            </columns>

            <items>
                <ColumnListItem>
                    <cells>
                        <Text text="{vendorCode}" />
                        <Text text="{vendorName}" />
                        <Text text="{vendorCategory}" />
                        <Text text="{materialCategory}" />
                        <Text text="{riskLevel}" />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    <!-- </f:DynamicPage> -->
    </Page>
</mvc:View>
