<mvc:View
    controllerName="project1.controller.Vendor"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:cards="sap.f.cards"
    xmlns:table="sap.m.table"
>
    <f:DynamicPage
        id="vendorDynamicPage"
        fitContent="true"
        headerExpanded="true"
        class="sapUiResponsiveContentPadding"
    >
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="Vendor Details" />
                </f:heading>

                <!-- <f:actions>
                    <Button
                        text="Add Vendor"
                        icon="sap-icon://add"
                        type="Emphasized"
                        press=".onAddVendor"
                    />
                </f:actions> -->
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader>
                <f:content>

                    <fb:FilterBar
                        id="vendorFilterBar"
                        showFilterConfiguration="false"
                        useToolbar="false"
                        showGoOnFB="false"
                    >

                        <fb:filterGroupItems>

                            <!-- Vendor Code -->
                            <fb:FilterGroupItem
                                label="Vendor Code"
                                name="VendorCode"
                                groupName="Vendor"
                                visibleInFilterBar="true"
                            >
                                <fb:control>
                                    <MultiComboBox
                                        id="vendorFilter"
                                        width="220px"
                                        selectionChange=".onVendorFilterChange"
                                        items="{
                                            path: '/Vendors',
                                            templateShareable: true
                                        }"
                                    >
                                        <core:Item
                                            key="{ID}"
                                            text="{vendorCode}"
                                        />
                                    </MultiComboBox>
                                </fb:control>
                            </fb:FilterGroupItem>


                            <!-- Vendor Name -->
                            <fb:FilterGroupItem
                                label="Vendor Name"
                                name="vendorName"
                                groupName="VendorName"
                                visibleInFilterBar="true"
                            >
                                <fb:control>
                                    <MultiComboBox
                                        id="vendorNameFilter"
                                        width="220px"
                                        selectionChange=".onVendorNameFilterChange"
                                        items="{
                                            path: '/Vendors',
                                            templateShareable: true
                                        }"
                                    >
                                        <core:Item
                                            key="{ID}"
                                            text="{vendorName}"
                                        />
                                    </MultiComboBox>
                                </fb:control>
                            </fb:FilterGroupItem>


                            <!-- Category -->
                            <fb:FilterGroupItem
                                label="Category"
                                name="vendorCategory"
                                groupName="VendorCategory"
                                visibleInFilterBar="true"
                            >
                                <fb:control>
                                    <MultiComboBox
                                        id="vendorCategoryFilter"
                                        width="220px"
                                        selectionChange=".onVendorCategoryFilterChange"
                                        items="{
                                            path: '/Vendors',
                                            templateShareable: true
                                        }"
                                    >
                                        <core:Item
                                            key="{vendorCategory}"
                                            text="{vendorCategory}"
                                        />
                                    </MultiComboBox>
                                </fb:control>
                            </fb:FilterGroupItem>


                            <!-- Risk Level -->
                            <fb:FilterGroupItem
                                label="Risk Level"
                                name="vendorRisk"
                                groupName="VendorRisk"
                                visibleInFilterBar="true"
                            >
                                <fb:control>
                                    <MultiComboBox
                                        id="vendorRiskFilter"
                                        width="220px"
                                        selectionChange=".onVendorRiskFilterChange"
                                        items="{
                                            path: '/Vendors',
                                            templateShareable: true
                                        }"
                                    >
                                        <core:Item
                                            key="{riskLevel}"
                                            text="{riskLevel}"
                                        />
                                    </MultiComboBox>
                                </fb:control>
                            </fb:FilterGroupItem>

                        </fb:filterGroupItems>

                    </fb:FilterBar>

                </f:content>
            </f:DynamicPageHeader>
        </f:header>


    
        <f:content>

            <VBox
                width="100%"
                class="sapUiMediumMarginTop"
            >
          

                <Table
                    id="vendorTable"
                    width="100%"
                    growing="true"
                    growingScrollToLoad="true"
                    mode="MultiSelect"
                    items="{
                        path: '/Vendors',
                        sorter: {
                            path: 'vendorCode'
                        }
                    }"
                >

                    <headerToolbar>
                        <OverflowToolbar>

                            <ToolbarSpacer />

                            <Button
                                icon="sap-icon://add"
                                tooltip="Add Vendor"
                                type="Transparent"
                                press=".addVendor"
                            />

                            <!-- Edit -->
                            <Button
                                icon="sap-icon://edit"
                                tooltip="Edit Vendor"
                                type="Transparent"
                                press=".onEditVendor"
                            />

                            <!-- Delete -->
                            <Button
                                icon="sap-icon://delete"
                                tooltip="Delete Vendor"
                                type="Transparent"
                                press=".onDeleteVendor"
                            />

                        </OverflowToolbar>
                    </headerToolbar>


                    <columns>

                        <Column width="10rem">
                            <Text text="Vendor Code" />
                        </Column>

                        <Column width="15rem">
                            <Text text="Vendor Name" />
                        </Column>

                        <Column width="12rem">
                            <Text text="Vendor Category" />
                        </Column>

                        <Column width="15rem">
                            <Text text="Material Category" />
                        </Column>

                        <Column width="10rem">
                            <Text text="Risk Level" />
                        </Column>

                    </columns>


                    <items>

                        <ColumnListItem
                            type="Navigation"
                            press=".onVendorPress"
                        >

                            <cells>

                                <Text
                                    text="{vendorCode}"
                                />

                                <Text
                                    text="{vendorName}"
                                />

                                <Text
                                    text="{vendorCategory}"
                                />

                                <Text
                                    text="{materialCategory}"
                                />

                                <ObjectStatus
                                    text="{riskLevel}"
                                />

                            </cells>

                        </ColumnListItem>

                    </items>

                </Table>

            </VBox>

        </f:content>

    </f:DynamicPage>

</mvc:View>

