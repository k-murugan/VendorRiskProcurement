<mvc:View
    controllerName="project1.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:micro="sap.suite.ui.microchart"
>
<!-- <Page>
<Title text="Procurement Team Dashboard"
       level='H1'>
       </Title> -->
    <tnt:ToolPage id="toolPage"
    sideExpanded="true">

        <tnt:sideContent>

            <tnt:SideNavigation
                id="sideNavigation"
                expanded="true"
                selectedKey="dashboard"
            >

                <tnt:NavigationList id="navigationList">

                    <tnt:NavigationListItem
                        key="dashboard"
                        text="Dashboard"
                        icon="sap-icon://home"
                        select=".onNavigationSelect"
                    />

                    <tnt:NavigationListItem
                        key="Vendor"
                        text="Vendors"
                        icon="sap-icon://supplier"
                        select=".onNavigationSelect"
                    />

                    <tnt:NavigationListItem
                        key="purchaseOrders"
                        text="Purchase Orders"
                        icon="sap-icon://cart"
                        select=".onNavigationSelect"
                    />

                    <tnt:NavigationListItem
                        key="invoices"
                        text="Invoices"
                        icon="sap-icon://receipt"
                        select=".onNavigationSelect"
                    />

                </tnt:NavigationList>

            </tnt:SideNavigation>

        </tnt:sideContent>
        <tnt:mainContents>

            <Page
                id="mainPage"
                showHeader="false"
            >


                <content>

                    <f:DynamicPage
                        id="dashboardPage"
                        fitContent="true"
                    >

                        <f:title>

                            <f:DynamicPageTitle>

                                <f:heading>

                                    <Title
                                        text="Procurement Overview"
                                    />

                                </f:heading>

                            </f:DynamicPageTitle>

                        </f:title>


                        <f:content>

                            <VBox
                                width="100%"
                                class="sapUiResponsiveContentPadding"
                            >

                                <HBox
                                    width="100%"
                                    wrap="Wrap"
                                    renderType="Bare"
                                    class="sapUiSmallMarginBottom"
                                >

                                    <GenericTile
                                        id="vendorTile"
                                        header="Total Vendors"
                                        press=".onVendorPress"
                                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                                        width="300px"
                                    >

                                        <TileContent>

                                            <NumericContent
                                                id="vendorCount"
                                                value="0"
                                                icon="sap-icon://supplier"
                                                valueColor="Good"
                                            />

                                        </TileContent>

                                    </GenericTile>

                                    <GenericTile
                                        id="poTile"
                                        header="Purchase Orders"
                                        press=".onPurchaseOrderPress"
                                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                                        width="300px"
                                    >

                                        <TileContent>

                                            <NumericContent
                                                id="poCount"
                                                value="0"
                                                icon="sap-icon://cart"
                                                valueColor="Neutral"
                                            />

                                        </TileContent>

                                    </GenericTile>

                                    <GenericTile
                                        id="invoiceTile"
                                        header="Total Invoices"
                                        press=".onInvoicePress"
                                        class="sapUiSmallMarginBottom"
                                        width="300px"
                                    >

                                        <TileContent>

                                            <NumericContent
                                                id="invoiceCount"
                                                value="0"
                                                icon="sap-icon://receipt"
                                                valueColor="Neutral"
                                            />

                                        </TileContent>

                                    </GenericTile>

                                </HBox>

                                <Panel
                                    headerText="Procurement Monitoring"
                                    expandable="false"
                                    class="sapUiSmallMarginBottom"
                                >

                                    <content>
                                    		<FlexBox height="70px" width="70px" renderType="Bare">
							<layoutData>
								<FlexItemData maxHeight="70px" />
							</layoutData>
							<micro:RadialMicroChart size="Responsive" percentage="45" app:name="radial" press=".press" />
						</FlexBox>

                                        <!-- <Text
                                            text="Monitor vendors, purchase orders and invoices from one central dashboard."
                                        /> -->

                                    </content>

                                </Panel>

                            </VBox>

                        </f:content>

                    </f:DynamicPage>

                </content>

            </Page>

        </tnt:mainContents>

    </tnt:ToolPage>
<!-- </Page> -->
</mvc:View>