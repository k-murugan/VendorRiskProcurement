<mvc:View
    controllerName="project1.controller.View1"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:viz.data="sap.viz.ui5.data"
    height="100%"
>
    <Page
        id="mainPage"
        showHeader="false"
        class="sapUiNoContentPadding"
    >

        <content>

            <f:DynamicPage
                id="dashboardPage"
                fitContent="true"
            >

                <!-- ========================= -->
                <!-- PAGE TITLE -->
                <!-- ========================= -->

                <f:title>
                    <f:DynamicPageTitle>
                        <f:heading>
                            <Title text="Procurement Overview" />
                        </f:heading>
                    </f:DynamicPageTitle>
                </f:title>


                <!-- ========================= -->
                <!-- PAGE CONTENT -->
                <!-- ========================= -->

                <f:content>

                    <VBox
                        width="100%"
                        class="sapUiResponsiveContentPadding"
                    >


                        <!-- ========================= -->
                        <!-- NAVIGATION TILES -->
                        <!-- ========================= -->

                        <HBox
                            width="100%"
                            wrap="Wrap"
                            justifyContent="Center"
                            class="sapUiSmallMarginBottom"
                        >

                            <!-- VENDORS -->

                            <GenericTile
                                id="vendorTile"
                                header="Vendors"
                                subheader="Manage Vendors"
                                press=".onVendorPress"
                                class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                                width="300px"
                            >

                                <TileContent>

                                    <NumericContent
                                        id="vendorCount"
                                        value="0"
                                        icon="sap-icon://supplier"
                                        valueColor="Good"
                                    />

                                </TileContent>

                            </GenericTile>


                            <!-- PURCHASE ORDERS -->

                            <GenericTile
                                id="poTile"
                                header="Purchase Orders"
                                subheader="Manage Purchase Orders"
                                press=".onPurchaseOrderPress"
                                class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                                width="300px"
                            >

                                <TileContent>

                                    <NumericContent
                                        id="poCount"
                                        value="0"
                                        icon="sap-icon://cart"
                                        valueColor="Neutral"
                                    />

                                </TileContent>

                            </GenericTile>


                            <!-- INVOICES -->

                            <GenericTile
                                id="invoiceTile"
                                header="Invoices"
                                subheader="Manage Invoices"
                                press=".onInvoicePress"
                                class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                                width="300px"
                            >

                                <TileContent>

                                    <NumericContent
                                        id="invoiceCount"
                                        value="0"
                                        icon="sap-icon://receipt"
                                        valueColor="Neutral"
                                    />

                                </TileContent>

                            </GenericTile>


                            <!-- RISK -->

                            <GenericTile
                                id="RiskTile"
                                header="Risk Calculation"
                                subheader="Vendor Risk"
                                press=".onVendorRisk"
                                class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                                width="300px"
                            >

                                <TileContent>

                                    <NumericContent
                                        id="RiskLevel"
                                        icon="sap-icon://risk"
                                        valueColor="Neutral"
                                    />

                                </TileContent>

                            </GenericTile>

                        </HBox>



                        <!-- ========================= -->
                        <!-- CHARTS -->
                        <!-- ========================= -->

                        <HBox
                            width="100%"
                            justifyContent="Center"
                            wrap="Wrap"
                        >


                            <!-- ========================= -->
                            <!-- VENDOR STATUS CARD -->
                            <!-- ========================= -->

                            <Panel
                                id="vendorStatusPanel"
                                headerText="Vendor Status"
                                width="450px"
                                class="sapUiSmallMargin"
                            >

                                <content>

                                    <VBox
                                        width="100%"
                                        alignItems="Center"
                                    >

                                        <viz:VizFrame
                                            id="idVizFrame"
                                            uiConfig="{applicationSet:'fiori'}"
                                            height="350px"
                                            width="420px"
                                            vizType="donut"
                                            vizProperties="{
                                                plotArea: {
                                                    dataLabel: {
                                                        visible: true,
                                                        type: 'value'
                                                    }
                                                },
                                                legend: {
                                                    visible: true
                                                },
                                                title: {
                                                    visible: false
                                                }
                                            }"
                                        >

                                            <viz:dataset>

                                                <viz.data:FlattenedDataset
                                                    data="{vendorChart>/VendorStatus}"
                                                >

                                                    <viz.data:dimensions>

                                                        <viz.data:DimensionDefinition
                                                            name="Vendor Status"
                                                            value="{vendorChart>status}"
                                                        />

                                                    </viz.data:dimensions>


                                                    <viz.data:measures>

                                                        <viz.data:MeasureDefinition
                                                            name="Vendor Count"
                                                            value="{vendorChart>count}"
                                                        />

                                                    </viz.data:measures>

                                                </viz.data:FlattenedDataset>

                                            </viz:dataset>


                                            <viz:feeds>

                                                <viz.feeds:FeedItem
                                                    uid="size"
                                                    type="Measure"
                                                    values="Vendor Count"
                                                />

                                                <viz.feeds:FeedItem
                                                    uid="color"
                                                    type="Dimension"
                                                    values="Vendor Status"
                                                />

                                            </viz:feeds>


                                            <viz:dependents>

                                                <viz:Popover
                                                    id="idPopOver"
                                                />

                                            </viz:dependents>

                                        </viz:VizFrame>

                                    </VBox>

                                </content>

                            </Panel>



                            <!-- ========================= -->
                            <!-- PURCHASE ORDER STATUS CARD -->
                            <!-- ========================= -->

                            <Panel
                                id="poStatusPanel"
                                headerText="Purchase Order Status"
                                width="450px"
                                class="sapUiSmallMargin"
                            >

                                <content>

                                    <VBox
                                        width="100%"
                                        alignItems="Center"
                                    >

                                        <viz:VizFrame
                                            id="idVizFrames"
                                            uiConfig="{applicationSet:'fiori'}"
                                            height="350px"
                                            width="420px"
                                            vizType="bar"
                                            vizProperties="{
                                                plotArea: {
                                                    dataLabel: {
                                                        visible: true,
                                                        type: 'value'
                                                    }
                                                },
                                                legend: {
                                                    visible: false
                                                },
                                                title: {
                                                    visible: false
                                                }
                                            }"
                                        >

                                            <viz:dataset>

                                                <viz.data:FlattenedDataset
                                                    data="{poChart>/poStatus}"
                                                >

                                                    <viz.data:dimensions>

                                                        <viz.data:DimensionDefinition
                                                            name="Purchase Order Status"
                                                            value="{poChart>status}"
                                                        />

                                                    </viz.data:dimensions>


                                                    <viz.data:measures>

                                                        <viz.data:MeasureDefinition
                                                            name="PO Count"
                                                            value="{poChart>count}"
                                                        />

                                                    </viz.data:measures>

                                                </viz.data:FlattenedDataset>

                                            </viz:dataset>


                                            <viz:feeds>

                                                <viz.feeds:FeedItem
                                                    uid="valueAxis"
                                                    type="Measure"
                                                    values="PO Count"
                                                />

                                                <viz.feeds:FeedItem
                                                    uid="categoryAxis"
                                                    type="Dimension"
                                                    values="Purchase Order Status"
                                                />

                                            </viz:feeds>


                                            <viz:dependents>

                                                <viz:Popover
                                                    id="idPopOvers"
                                                />

                                            </viz:dependents>

                                        </viz:VizFrame>

                                    </VBox>

                                </content>

                            </Panel>

                        </HBox>

                    </VBox>

                </f:content>

            </f:DynamicPage>

        </content>

    </Page>

</mvc:View>