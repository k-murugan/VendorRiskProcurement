<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="Dialog"
        title="Purchase Order Details"
    >
        <content>
            <f:SimpleForm
                editable="true"
                layout="ColumnLayout"
                columnsL="2"
            >
                <f:content>

                    <Label
                        text="PO Number"
                        required="true"
                    />
                    <Input
                        id="inputPONumber"
                        type="Text"
                    />

                    <Label
                        text="PO Date"
                        required="true"
                    />
                    <Input
                        id="inputPODate"
                        type="Date"
                    />

                    <Label
                        text="Expected Delivery Date"
                        required="true"
                    />
                    <Input
                        id="inputExpectedDate"
                        type="Date"
                    />

                    <Label
                        text="PO Status"
                        required="true"
                    />
                    <ComboBox
                        id="inputPOStatus"
                        selectedKey="DRAFT"
                        editable="true"
                    >
                        <core:Item
                            key="DRAFT"
                            text="DRAFT"
                        />
                        <core:Item
                            key="PENDING_APPROVAL"
                            text="PENDING APPROVAL"
                        />
                        <core:Item
                            key="APPROVED"
                            text="APPROVED"
                        />
                        <core:Item
                            key="REJECTED"
                            text="REJECTED"
                        />
                        <core:Item
                            key="SENT_TO_VENDOR"
                            text="SENT TO VENDOR"
                        />
                        <core:Item
                            key="ACCEPTED"
                            text="ACCEPTED"
                        />
                        <core:Item
                            key="PARTIALLY_DELIVERED"
                            text="PARTIALLY DELIVERED"
                        />
                        <core:Item
                            key="FULLY_DELIVERED"
                            text="FULLY DELIVERED"
                        />
                        <core:Item
                            key="CANCELLED"
                            text="CANCELLED"
                        />
                        <core:Item
                            key="CLOSED"
                            text="CLOSED"
                        />
                    </ComboBox>

                    <Label
                        text="Total Amount"
                        required="true"
                    />
                    <Input
                        id="inputAmount"
                        type="Number"
                    />

                    <Label
                        text="Currency"
                        required="true"
                    />
                    <Input
                        id="inputCurrency"
                        value="INR"
                    />

                    <Label
                        text="Payment Terms"
                        required="true"
                    />
                    <ComboBox
                        id="inputPaymentTerms"
                        selectedKey="NET30"
                        editable="true"
                    >
                        <core:Item
                            key="IMMEDIATE"
                            text="IMMEDIATE"
                        />
                        <core:Item
                            key="NET15"
                            text="NET15"
                        />
                        <core:Item
                            key="NET30"
                            text="NET30"
                        />
                        <core:Item
                            key="NET45"
                            text="NET45"
                        />
                        <core:Item
                            key="NET60"
                            text="NET60"
                        />
                        <core:Item
                            key="NET90"
                            text="NET90"
                        />
                    </ComboBox>

                    <Label
                        text="Contact Reference"
                        required="true"
                    />
                    <Input
                        id="inputContactReference"
                        type="Text"
                    />

                </f:content>
            </f:SimpleForm>
        </content>

        <beginButton>
            <Button
                text="Create"
                type="Emphasized"
                press=".onCreate"
            />
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press=".onCloseDialog"
            />
        </endButton>

    </Dialog>
</core:FragmentDefinition>