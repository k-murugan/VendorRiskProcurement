<mvc:View
    controllerName="project1.controller.POItem"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:uxap="sap.uxap"
    xmlns:form="sap.ui.layout.form"
    height="100%"
>
    <uxap:ObjectPageLayout
        id="poObjectPage"
        upperCaseAnchorBar="false"
        showAnchorBar="false"
        enableLazyLoading="false"
        useIconTabBar="false"
    >

        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>

                <uxap:expandedHeading>
                    <VBox>
                        <Title text="Purchase Order" level="H1" />
                        <Text
                            text="Purchase order details and order items"
                            class="sapUiTinyMarginTop"
                        />
                    </VBox>
                </uxap:expandedHeading>

                <uxap:snappedHeading>
                    <Title text="Purchase Order" />
                </uxap:snappedHeading>

                <uxap:actions>

                    <Button
                        id="editButton"
                        text="Edit"
                        icon="sap-icon://edit"
                        type="Emphasized"
                        visible="{= !${ui>/editMode} &amp;&amp; !${ui>/isNew} }"
                        press=".onEdit"
                    />

                    <Button
                        id="saveButton"
                        text="Save"
                        icon="sap-icon://save"
                        type="Emphasized"
                        visible="{ui>/editMode}"
                        press=".onSave"
                    />

                    <Button
                        id="cancelEditButton"
                        text="Cancel"
                        icon="sap-icon://decline"
                        visible="{ui>/editMode}"
                        press=".onCancelEdit"
                    />

                </uxap:actions>

            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>


        <!-- ===================================================== -->
        <!-- SECTIONS -->
        <!-- ===================================================== -->

        <uxap:sections>

            <!-- ================================================= -->
            <!-- PURCHASE ORDER DETAILS -->
            <!-- ================================================= -->

            <uxap:ObjectPageSection title="Purchase Order Details" titleUppercase="false">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection showTitle="false" titleUppercase="false">
                        <uxap:blocks>

                            <VBox width="100%">

                                <form:SimpleForm
                                    editable="{ui>/editMode}"
                                    layout="ColumnLayout"
                                    columnsM="2"
                                    columnsL="2"
                                    columnsXL="2"
                                >

                                    <!-- PO Number -->
                                    <Label text="PO Number" required="true" />
                                    <Input
                                        value="{po>/poNumber}"
                                        editable="{ui>/editMode}"
                                        width="100%"
                                    />

                                    <!-- Currency -->
                                    <Label text="Currency" required="true" />
                                    <ComboBox
                                        selectedKey="{po>/currency}"
                                        editable="{ui>/editMode}"
                                        width="100%"
                                    >
                                        <core:Item key="INR" text="INR" />
                                        <core:Item key="USD" text="USD" />
                                        <core:Item key="EUR" text="EUR" />
                                    </ComboBox>

                                    <!-- Contract Reference -->
                                    <Label text="Contract Reference" />
                                    <Input
                                        value="{po>/contractReference}"
                                        editable="{ui>/editMode}"
                                        placeholder="Enter contract reference"
                                        width="100%"
                                    />

                                    <!-- Expected Delivery Date -->
                                    <Label text="Expected Delivery Date" required="true" />
                                    <DatePicker
                                        value="{po>/expectedDeliveryDate}"
                                        editable="{ui>/editMode}"
                                        valueFormat="yyyy-MM-dd"
                                        displayFormat="yyyy-MM-dd"
                                        width="100%"
                                    />

                                    <!-- Payment Terms -->
                                    <Label text="Payment Terms" required="true" />
                                    <ComboBox
                                        selectedKey="{po>/paymentTerms}"
                                        editable="{ui>/editMode}"
                                        width="100%"
                                    >
                                        <core:Item key="IMMEDIATE" text="Immediate" />
                                        <core:Item key="NET15" text="NET15" />
                                        <core:Item key="NET30" text="NET30" />
                                        <core:Item key="NET45" text="NET45" />
                                        <core:Item key="NET60" text="NET60" />
                                        <core:Item key="NET90" text="NET90" />
                                    </ComboBox>

                                    <!-- Total Amount -->
                                    <Label text="Total Amount" />
                                    <Input
                                        value="{po>/totalAmount}"
                                        editable="false"
                                        width="100%"
                                    />

                                </form:SimpleForm>

                            </VBox>

                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>


            <!-- ================================================= -->
            <!-- ORDER ITEMS -->
            <!-- ================================================= -->

            <uxap:ObjectPageSection title="Order Items" titleUppercase="false">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection showTitle="false" titleUppercase="false">
                        <uxap:blocks>

                            <VBox width="100%">

                                <OverflowToolbar>
                                    <Title text="Purchase Order Items" />
                                    <ToolbarSpacer />
                                </OverflowToolbar>

                                <Table
                                    id="orderItemsTable"
                                    width="100%"
                                    growing="true"
                                    growingThreshold="10"
                                    growingScrollToLoad="true"
                                    inset="false"
                                    noDataText="No Purchase Order Items Found"
                                    items="{po>/items}"
                                >

                                    <!-- COLUMNS -->
                                    <columns>

                                        <Column width="16rem">
                                            <Text text="Material" />
                                        </Column>

                                        <Column width="9rem">
                                            <Text text="Material Group" />
                                        </Column>

                                        <Column width="16rem">
                                            <Text text="Description" />
                                        </Column>

                                        <Column width="8rem">
                                            <Text text="Quantity" />
                                        </Column>

                                        <Column width="7rem">
                                            <Text text="Unit" />
                                        </Column>

                                        <Column width="10rem" hAlign="End">
                                            <Text text="Old Unit Price" />
                                        </Column>

                                        <Column width="10rem" hAlign="End">
                                            <Text text="Contract Price" />
                                        </Column>

                                        <Column width="10rem" hAlign="End">
                                            <Text text="Total Amount" />
                                        </Column>

                                        <Column width="13rem">
                                            <Text text="Requested Delivery Date" />
                                        </Column>

                                    </columns>

                                    <!-- ROWS -->
                                    <items>

                                        <ColumnListItem>

                                            <!-- Material (list comes from the "materials" JSON model) -->
                                            <ComboBox
                                                selectedKey="{po>materialCode}"
                                                editable="{ui>/editMode}"
                                                width="100%"
                                                showSecondaryValues="true"
                                                selectionChange=".onMaterialChange"
                                                items="{
                                                    path: 'materials>/items',
                                                    templateShareable: false
                                                }"
                                            >
                                                <core:ListItem
                                                    key="{materials>materialCode}"
                                                    text="{materials>materialCode}"
                                                    additionalText="{materials>materialDescription}"
                                                />
                                            </ComboBox>

                                            <!-- Material Group -->
                                            <Text text="{po>materialGroup}" />

                                            <!-- Description -->
                                            <Text text="{po>description}" />

                                            <!-- Quantity -->
                                            <Input
                                                value="{po>quantity}"
                                                editable="{ui>/editMode}"
                                                type="Number"
                                                width="100%"
                                                liveChange=".onQuantityChange"
                                            />

                                            <!-- Unit -->
                                            <ComboBox
                                                selectedKey="{po>unit}"
                                                editable="{ui>/editMode}"
                                                width="100%"
                                            >
                                                <core:Item key="EA" text="EA" />
                                                <core:Item key="KG" text="KG" />
                                                <core:Item key="G" text="G" />
                                                <core:Item key="L" text="L" />
                                                <core:Item key="M" text="M" />
                                                <core:Item key="CM" text="CM" />
                                                <core:Item key="BOX" text="BOX" />
                                                <core:Item key="BAG" text="BAG" />
                                                <core:Item key="SET" text="SET" />
                                                <core:Item key="PACK" text="PACK" />
                                            </ComboBox>

                                            <!-- Old Unit Price -->
                                            <Input
                                                value="{po>oldUnitPrice}"
                                                editable="{ui>/editMode}"
                                                type="Number"
                                                textAlign="End"
                                                width="100%"
                                                liveChange=".onPriceChange"
                                            />

                                            <!-- Contract Price -->
                                            <Text text="{po>contractPrice}" />

                                            <!-- Total Amount -->
                                            <Text text="{po>totalAmount}" />

                                            <!-- Requested Delivery Date -->
                                            <DatePicker
                                                value="{po>requestedDeliveryDate}"
                                                editable="{ui>/editMode}"
                                                valueFormat="yyyy-MM-dd"
                                                displayFormat="yyyy-MM-dd"
                                                width="100%"
                                            />

                                        </ColumnListItem>

                                    </items>

                                </Table>

                            </VBox>

                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>


            <!-- ================================================= -->
            <!-- ADDITIONAL INFORMATION -->
            <!-- ================================================= -->

            <uxap:ObjectPageSection title="Additional Information" titleUppercase="false">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection showTitle="false" titleUppercase="false">
                        <uxap:blocks>

                            <form:SimpleForm
                                editable="{ui>/editMode}"
                                layout="ColumnLayout"
                                columnsM="2"
                                columnsL="2"
                                columnsXL="2"
                            >

                                <Label text="Buyer" />

                                <ComboBox
                                    selectedKey="{po>/buyer_ID}"
                                    editable="{ui>/editMode}"
                                    width="100%"
                                    items="{
                                        path: '/Employee',
                                        templateShareable: false
                                    }"
                                >
                                    <core:Item key="{ID}" text="{name}" />
                                </ComboBox>

                            </form:SimpleForm>

                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

        </uxap:sections>

    </uxap:ObjectPageLayout>
</mvc:View>
