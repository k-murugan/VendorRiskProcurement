<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="helloDialog"
        title="Vendor Details"
    >
        <content>
            <f:SimpleForm
                editable="false"
                layout="ColumnLayout"
                columnsL="2"
            >
                <f:content>
                    <Label
                        text="Vendor Code"
                        required="true"
                    />
                    <Input
                        value=""
                        type="Text"
                        id="inputVendorCode"
                    />
                    <Label
                        text="Name"
                        required="true"
                    />
                    <Input
                        value=""
                        type="Text"
                        id="inputName"
                    />
                    <Label
                        text="Country"
                        required="true"
                    />
                    <Input
                        value=""
                        type="Text"
                        id="inputCountry"
                    />
                    <Label
                        text="Region"
                        required="true"
                    />
                    <Input
                        value=""
                        type="Text"
                        id="inputRegion"
                    />
                    <Label
                        text="Category"
                        required="true"
                    />
                    <Input
                        value=""
                        type="Text"
                        id="inputCategory"
                    />
                    <Label
                        text="Material Category"
                        required="true"
                    />
                    <Input
                        value=""
                        id="inputMaterial"
                    />
                    <Label
                        text="Contact Person"
                        required="true"
                    />
                    <Input
                        value=""
                        type="Text"
                        id="inputContact"
                    />
                    <Label
                        text="Email ID"
                        required="true"
                    />
                    <Input
                        value=""
                        type="Email"
                        id="inputEmail"
                    />
                    <Label
                        text="Phone Number"
                        required="true"
                    />
                    <Input
                        value=""
                        type="Number"
                        id="inputPhone"
                    />
                    <Label
                        text="Status"
                        required="true"
                    />
                    <!-- <Input value="" 
                    id="inputStatus"/> -->
                    <ComboBox
                        id="inputStatus"
                        selectedKey="{status}"
                        editable="true"
                    >
                        <core:Item
                            key="ACTIVE"
                            text="ACTIVE"
                        />
                        <core:Item
                            key="INACTIVE"
                            text="INACTIVE"
                        />
                        <core:Item
                            key='BLOCKED'
                            text="BLOCKED"
                        />
                        <core:Item
                            key='SUSPENDED'
                            text='SUSPENDED'
                        />
                        <core:Item
                            key='BLACKLISTED'
                            text="BLACKLISTED"
                        />
                    </ComboBox>
                </f:content>
            </f:SimpleForm>
        </content>
        <beginButton>
            <Button
                text="Create"
                type="Emphasized"
                press=".onCreate"
            />
        </beginButton>
        <endButton>
            <Button
                text="Cancel"
                press=".onCloseDialog"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
