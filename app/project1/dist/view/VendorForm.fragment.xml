<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="helloDialog"
        title="Vendor Details"
    >
        <content>

            <f:SimpleForm
                editable="true"
                layout="ColumnLayout"
                columnsL="2"
            >

                <f:content>

                    <Label
                        text="Vendor Code"
                        required="true"
                    />
                    <Input
                        id="inputVendorCode"
                        type="Text"
                        placeholder="Enter Vendor Code"
                    />

                    <Label
                        text="Name"
                        required="true"
                    />
                    <Input
                        id="inputName"
                        type="Text"
                        placeholder="Enter Vendor Name"
                    />

                    <Label
                        text="Country"
                        required="true"
                    />
                    <Input
                        id="inputCountry"
                        type="Text"
                        placeholder="Enter Country"
                    />

                    <Label
                        text="Region"
                        required="true"
                    />
                    <Input
                        id="inputRegion"
                        type="Text"
                        placeholder="Enter Region"
                    />

                    <Label
                        text="Category"
                        required="true"
                    />
                    <Input
                        id="inputCategory"
                        type="Text"
                        placeholder="Enter Category"
                    />

                    <Label
                        text="Material Category"
                        required="true"
                    />
                    <Input
                        id="inputMaterial"
                        type="Text"
                        placeholder="Enter Material Category"
                    />

                    <Label
                        text="Contact Person"
                        required="true"
                    />
                    <Input
                        id="inputContact"
                        type="Text"
                        placeholder="Enter Contact Person"
                    />

                    <Label
                        text="Email ID"
                        required="true"
                    />
                    <Input
                        id="inputEmail"
                        type="Email"
                        placeholder="Enter Email"
                    />

                    <Label
                        text="Phone Number"
                        required="true"
                    />
                    <Input
                        id="inputPhone"
                        type="Number"
                        placeholder="Enter Phone Number"
                    />

                    <Label
                        text="Status"
                        required="true"
                    />

                    <ComboBox
                        id="inputStatus"
                        selectedKey="ACTIVE"
                        editable="true"
                    >
                        <core:Item
                            key="ACTIVE"
                            text="ACTIVE"
                        />
                        <core:Item
                            key="INACTIVE"
                            text="INACTIVE"
                        />
                        <core:Item
                            key="BLOCKED"
                            text="BLOCKED"
                        />
                        <core:Item
                            key="SUSPENDED"
                            text="SUSPENDED"
                        />
                        <core:Item
                            key="BLACKLISTED"
                            text="BLACKLISTED"
                        />
                    </ComboBox>

                </f:content>

            </f:SimpleForm>

        </content>

        <beginButton>
            <Button
                text="Create"
                type="Emphasized"
                press=".onCreate"
            />
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press=".onCloseDialog"
            />
        </endButton>

    </Dialog>
</core:FragmentDefinition>