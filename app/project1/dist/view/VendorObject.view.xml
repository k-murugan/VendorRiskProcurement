<mvc:View
    controllerName="project1.controller.VendorObject"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:uxap="sap.uxap"
    xmlns:form="sap.ui.layout.form"
    height="100%"
>
    <uxap:ObjectPageLayout
        id="VenObjectPage"
        upperCaseAnchorBar="false"
        showAnchorBar="false"
        enableLazyLoading="false"
        useIconTabBar="false"
    >
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>
                <uxap:expandedHeading>
                    <VBox>
                        <Title
                            text="Vendor Details"
                            level="H1"
                        />
                        <Text
                            text="Create a new Vendor."
                            class="sapUiTinyMarginTop"
                        />
                    </VBox>
                </uxap:expandedHeading>
                <uxap:snappedHeading>
                    <Title text="Create Vendor" />
                </uxap:snappedHeading>
                <uxap:actions>
                    <Button
                        text="Edit"
                        icon="sap-icon://edit"
                        type="Emphasized"
                        visible="{= !${ui>/editMode} &amp;&amp; !${ui>/isNew} }"
                        press=".onEdit"
                    />

                    <Button
                        text="Save"
                        icon="sap-icon://save"
                        type="Emphasized"
                        visible="{= ${ui>/editMode} }"
                        press=".onSave"
                    />

                    <Button
                        text="Cancel"
                        icon="sap-icon://decline"
                        visible="{= ${ui>/editMode} }"
                        press=".onCancelEdit"
                    />
                </uxap:actions>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>

        <uxap:sections>
            <uxap:ObjectPageSection
                title="Vendor Details"
                titleUppercase="false"
            >
                <uxap:subSections>
                    <uxap:ObjectPageSubSection
                        titleUppercase="false"
                        showTitle="false"
                    >
                        <uxap:blocks>
                            <VBox width="100%">
                                <form:SimpleForm
                                    editable="{ui>/editMode}"
                                    layout="ColumnLayout"
                                    columnsM="2"
                                    columnsL="2"
                                    columnsXL="2"
                                >
                                    <Label
                                        text="Vendor Code"
                                        required="true"
                                    />

                                    <Input
                                        value="{ven>/vendorCode}"
                                        editable="{ui>/editMode}"
                                    />

                                    <Label
                                        text="Vendor Name"
                                        required="true"
                                    />
                                    <Input 
                                        value="{ven>/vendorName}"
                                        editable="{ui>/editMode}"
                                    />

                                    <!-- <ComboBox
                                        selectedKey="{ven>/vendorName}"
                                        editable="{ui>/editMode}"
                                        width="100%"
                                    >
                                        <core:Item
                                            key="INR"
                                            text="INR"
                                        />

                                        <core:Item
                                            key="USD"
                                            text="USD"
                                        />

                                        <core:Item
                                            key="EUR"
                                            text="EUR"
                                        />
                                    </ComboBox> -->

                                    <Label text="Country" />

                                    <Input
                                        value="{ven>/country}"
                                        editable="{ui>/editMode}"
                                        placeholder="Enter country"
                                    />

                                    <Label
                                        text="Region"
                                        required="true"
                                    />

                                    <Input
                                        value="{ven>/region}"
                                        editable="{ui>/editMode}"

                                    />

                                    <Label
                                        text="Vendor Category"
                                        required="true"
                                    />
                                    <Input 
                                    value="{ven>/vendorCategory}"
                                     editable="{ui>/editMode}"
                                     />


                                    <Label
                                        text="Material Category"
                                        required="true"
                                    />
                                    <Input 
                                    value="{ven>/materialCategory}"
                                     editable="{ui>/editMode}"
                                    />
                                    <Label
                                        text="Status"
                                        required="true"
                                    />
                                    <ComboBox
                                        selectedKey="{ven>/vendorStatus}"
                                        editable="{ui>/editMode}"
                                        width="100%"
                                    >
                                        <core:Item
                                            key="ACTIVE"
                                            text="ACTIVE"
                                        />

                                        <core:Item
                                            key="INACTIVE"
                                            text="INACTIVE"
                                        />

                                        <core:Item
                                            key="BLOCKED"
                                            text="BLOCKED"
                                        />
                                         <core:Item
                                            key="SUSPENDED"
                                            text="SUSPENDED"
                                        />
                                         <core:Item
                                            key="BLACKLISTED"
                                            text="BLACKLISTED"
                                        />
                                    </ComboBox>
                                   

                              
                                </form:SimpleForm>
                            </VBox>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
           

