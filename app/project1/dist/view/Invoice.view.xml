<mvc:View
    controllerName="project1.controller.Invoice"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:cards="sap.f.cards"
>
    <f:DynamicPage
        id="invoiceDynamicPage"
        fitContent="true"
        headerExpanded="true"
        class="sapUiResponsiveContentPadding"
    >
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="Invoice Details" />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader>
                <f:content>
                    <fb:FilterBar
                        id="invoiceFilterBar"
                        showFilterConfiguration="false"
                        useToolbar="false"
                        showGoOnFB="false"
                    >
                        <fb:filterGroupItems>
                            <fb:FilterGroupItem
                                label="Invoice Number"
                                name="invoice"
                                groupName="invoice"
                                visibleInFilterBar="true"
                            >
                                <fb:control>
                                    <MultiComboBox
                                        id="invoiceFilter"
                                        width="220px"
                                        selectionChange=".onInvoiceFilterChange"
                                        items="{
                                            path: '/Invoices',
                                            templateShareable: true
                                        }"
                                    >
                                        <core:Item
                                            key="{invoiceNumber}"
                                            text="{invoiceNumber}"
                                        />
                                    </MultiComboBox>
                                </fb:control>
                            </fb:FilterGroupItem>

                            <fb:FilterGroupItem
                                label="Invoice Status"
                                name="invoiceStatus"
                                groupName="inStatus"
                                visibleInFilterBar="true"
                            >
                                <fb:control>
                                    <MultiComboBox
                                        id="inStatusFilter"
                                        width="220px"
                                        selectionChange=".onInStatusFilterChange"
                                        items="{invoiceStatus>/statuses}"
                                    >
                                        <core:Item
                                            key="{invoiceStatus>status}"
                                            text="{invoiceStatus>status}"
                                        />
                                    </MultiComboBox>
                                </fb:control>
                            </fb:FilterGroupItem>
                        </fb:filterGroupItems>
                    </fb:FilterBar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <VBox
                width="100%"
                class="sapUiMediumMarginTop"
            >
                <Toolbar>
                    <Title text="Invoice List" />
                    <ToolbarSpacer />
                    <Button
                        id="editInvoiceButton"
                        icon="sap-icon://edit"
                        tooltip="Edit Invoice"
                        type="Transparent"
                        press=".onEditInvoice"
                    />

                    <Button
                        id="saveInvoiceButton"
                        icon="sap-icon://save"
                        tooltip="Save Invoice"
                        type="Emphasized"
                        press=".onSaveInvoice"
                        visible="false"
                    />

                    <Button
                        id="cancelInvoiceButton"
                        icon="sap-icon://decline"
                        tooltip="Cancel Edit"
                        type="Transparent"
                        press=".onCancelInvoice"
                        visible="false"
                    />
                    <Button
                        icon="sap-icon://delete"
                        tooltip="Delete Invoice"
                        type="Transparent"
                        press=".onDeleteInvoice"
                    />
                </Toolbar>
                <Table
                    mode="MultiSelect"
                    id="invoiceTable"
                    width="100%"
                    growing="true"
                    growingThreshold="10"
                    growingScrollToLoad="true"
                    items="{
                        path: '/Invoices',
                        sorter: {
                            path: 'invoiceNumber'
                        },
                         parameters: {
                            $$updateGroupId: 'invoiceUpdate'
                        }
                    }"
                >
                    <columns>
                        <Column>
                            <Text text="Invoice Number" />
                        </Column>
                        <Column>
                            <Text text="Invoice Date" />
                        </Column>
                        <Column>
                            <Text text="Material Code" />
                        </Column>
                        <Column>
                            <Text text="Quantity" />
                        </Column>
                        <Column>
                            <Text text="Estimated Price" />
                        </Column>
                        <Column>
                            <Text text="Actual Price" />
                        </Column>
                        <Column>
                            <Text text="Price Difference" />
                        </Column>
                        <Column>
                            <Text text="Invoice Amount" />
                        </Column>
                        <Column>
                            <Text text="Status" />
                        </Column>
                        <Column>
                            <Text text="Risk Level" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem
                            type="Navigation"
                            press=".onVendorPress"
                        >
                            <cells>
                                <Input
                                    value="{invoiceNumber}"
                                    editable="{ui>/editMode}"
                                />

                                <Input
                                    value="{invoiceDate}"
                                    type="Date"
                                    editable="{ui>/editMode}"
                                />

                                <Input
                                    value="{materialCode}"
                                    editable="{ui>/editMode}"
                                />

                                <Input
                                    value="{quantity}"
                                    type="Number"
                                    editable="{ui>/editMode}"
                                />
                                <Input
                                    value="{oldPrice}"
                                    type="Number"
                                    editable="{ui>/editMode}"
                                />
                                <Input
                                    value="{currentPrice}"
                                    type="Number"
                                    editable="{ui>/editMode}"
                                />
                                <Text text="{priceDifference}" />
                                <Text text="{invoiceAmount}" />
                                <ComboBox
                                    selectedKey="{invoiceStatus}"
                                    editable="{ui>/editMode}"
                                >
                                    <core:Item
                                        key="Draft"
                                        text="Draft"
                                    />
                                    <core:Item
                                        key="Submitted"
                                        text="Submitted"
                                    />
                                    <core:Item
                                        key="Approved"
                                        text="Approved"
                                    />
                                    <core:Item
                                        key="Rejected"
                                        text="Rejected"
                                    />
                                </ComboBox>
                                <Text text="{riskLevel}" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
